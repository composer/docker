{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "labels": [
        "dependencies"
    ],
    "extends": [
        "config:recommended",
        "helpers:pinGitHubActionDigests"
    ],
    "packageRules": [
        {
            "description": "Batch action updates (each one triggers full multi-arch builds) and add a cooldown",
            "matchManagers": [
                "github-actions"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "digest"
            ],
            "groupName": "GitHub Actions",
            "minimumReleaseAge": "7 days"
        },
        {
            "matchPackageNames": [
                "composer/composer"
            ],
            "separateMinorPatch": true
        },
        {
            "description": "2.2 is LTS: patch releases only",
            "matchFileNames": [
                "2.2/Dockerfile"
            ],
            "matchPackageNames": [
                "composer/composer"
            ],
            "allowedVersions": "<2.3.0",
            "commitMessageSuffix": " (2.2)",
            "additionalBranchPrefix": "2.2-"
        },
        {
            "matchFileNames": [
                "latest/Dockerfile"
            ],
            "matchPackageNames": [
                "composer/composer"
            ],
            "commitMessageSuffix": " (Latest)",
            "additionalBranchPrefix": "latest-"
        },
        {
            "description": "A new Composer major needs manual follow-up",
            "matchFileNames": [
                "latest/Dockerfile"
            ],
            "matchPackageNames": [
                "composer/composer"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "prBodyNotes": [
                "⚠️ New major: update aliases in `generate-stackbrew-library.sh` and consider creating an LTS directory for the previous major."
            ]
        },
        {
            "description": "Legacy/LTS images stay on PHP 8",
            "matchFileNames": [
                "1.10/Dockerfile",
                "2.2/Dockerfile"
            ],
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "php"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "enabled": false
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Composer version in maintained Dockerfiles (1.10 is frozen)",
            "managerFilePatterns": [
                "/^(latest|2\\.2)/Dockerfile$/"
            ],
            "matchStrings": [
                "ENV COMPOSER_VERSION=[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-RC\\d+)?)[\"']?\\s"
            ],
            "datasourceTemplate": "github-releases",
            "depNameTemplate": "composer/composer"
        }
    ]
}
